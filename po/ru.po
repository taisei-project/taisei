msgstr "Знак Кеплера «Орбитальный механизм»"

#: src/stages/stage6/stage6.c:39
msgid "Maxwell Sign “Wave Theory”"
msgstr "Знак Максвелла «Волновая теория»"

#: src/stages/stage6/stage6.c:47
msgid "Eigenstate “Many-World Interpretation”"
msgstr "Собственное состояние «Многомировая интерпретация»"

#: src/stages/stage6/stage6.c:52
msgid "de Broglie Sign “Wave-Particle Duality”"
msgstr "Знак де Бройля «Корпускулярно-волновой дуализм»"

#: src/stages/stage6/stage6.c:57

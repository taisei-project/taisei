
#ifndef I_SPRITE_H
#define I_SPRITE_H

#include "../lib/defs.glslh"

#ifdef VERT_STAGE
/*
 * Per-vertex attributes
 */
ATTRIBUTE(0) vec2  vertPos;
ATTRIBUTE(1) vec2  vertTexCoord;
ATTRIBUTE(2) vec3  vertNormal;
ATTRIBUTE(3) vec4  vertTangent;

/*
 * Per-instance attributes
 */
ATTRIBUTE(4)   vec4  spriteVMTransform0;
ATTRIBUTE(5)   vec4  spriteVMTransform1;
ATTRIBUTE(6)   vec4  spriteVMTransform2;
ATTRIBUTE(7)   vec4  spriteVMTransform3;
ATTRIBUTE(8)   vec4  spriteRGBA;
ATTRIBUTE(9)   vec4  spriteCustomVec0;
ATTRIBUTE(10)  vec4  spriteCustomVec1;
ATTRIBUTE(11)  vec4  spriteCustomVec2;
ATTRIBUTE(12)  vec4  spriteCustomVec3;
ATTRIBUTE(13)  vec4  spriteCustomVec4;
ATTRIBUTE(14)  vec4  spriteTexRegion;
ATTRIBUTE(15)  vec2  spriteDimensions;

#define spriteCustomVec     spriteCustomVec0
#define spriteVMTransform   mat4(spriteVMTransform0, spriteVMTransform1, spriteVMTransform2, spriteVMTransform3)
#define spriteCustomMatrix  mat4(spriteCustomVec1, spriteCustomVec2, spriteCustomVec3, spriteCustomVec4)

#endif

#ifdef FRAG_STAGE
OUT(0) vec4 fragColor;
#endif

UNIFORM(0) sampler2D tex;

// see NUM_SPRITE_AUX_TEXTURES in api.h.
UNIFORM(64) sampler2D tex_aux0;
UNIFORM(65) sampler2D tex_aux1;
UNIFORM(66) sampler2D tex_aux2;

VARYING(0)  vec2  texCoordRaw;
VARYING(1)  vec2  texCoord;
VARYING(2)  vec2  texCoordOverlay;
VARYING(3)  vec4  texRegion;
VARYING(4)  vec4  color;
VARYING(5)  vec2  dimensions;
VARYING(6)  vec4  customVec0;
VARYING(7)  vec4  customVec1;
VARYING(8)  vec4  customVec2;
VARYING(9)  vec4  customVec3;
VARYING(10) vec4  customVec4;

#define customParams customVec0
#define customMatrix mat4(customVec1, customVec2, customVec3, customVec4)

#endif
